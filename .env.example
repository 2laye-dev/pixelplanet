ADMIN_USERNAME=admin
# Generate with npm run admin:password -- "your-long-password"
ADMIN_PASSWORD_HASH=
# Generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SITE_URL=http://localhost:3000
# Absolute persistent directory outside public_html recommended on cPanel
# DATA_DIR=/home/CPANEL_USER/pixelplanet-data
# Set only for local HTTP production preview; leave true for HTTPS hosting
COOKIE_SECURE=true
